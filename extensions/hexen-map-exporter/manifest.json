{
  "manifest_version": 3,
  "name": "Hexen Map Exporter — teste",
  "version": "0.2.0",
  "description": "Exporta localmente os IDs coletados carregados pelo AppSample. Sem credenciais ou sincronização.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hexen Map Exporter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://genshin-impact-map.appsample.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://genshin-impact-map.appsample.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": [
    "https://genshin-impact-map.appsample.com/*"
  ],
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ]
}
