{
  "manifest_version": 3,
  "name": "Hexen Map Exporter",
  "version": "2.0.4",
  "description": "Exporta localmente os IDs coletados do AppSample e HoYoLAB. Sem credenciais ou sincronização.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hexen Map Exporter",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://genshin-impact-map.appsample.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://genshin-impact-map.appsample.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://act.hoyolab.com/*"
      ],
      "js": [
        "hoyolab-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://act.hoyolab.com/*"
      ],
      "js": [
        "hoyolab-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": [
    "https://genshin-impact-map.appsample.com/*",
    "https://act.hoyolab.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "hoyolab-index.json"
      ],
      "matches": [
        "https://act.hoyolab.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ]
}
